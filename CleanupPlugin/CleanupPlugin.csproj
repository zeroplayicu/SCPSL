<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>CleanupPlugin</AssemblyName>
    <RootNamespace>CleanupPlugin</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>Developer</Authors>
    <Description>掉落物自动清理插件</Description>
    <OutputType>Library</OutputType>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <LangVersion>12.0</LangVersion>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Exiled.API" Version="9.13.3" />
    <PackageReference Include="Exiled.Events" Version="9.13.3" />
    <PackageReference Include="Exiled.Loader" Version="9.13.3" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
