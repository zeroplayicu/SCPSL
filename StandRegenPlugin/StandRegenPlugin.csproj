<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>StandRegenPlugin</AssemblyName>
    <RootNamespace>StandRegenPlugin</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>Developer</Authors>
    <Company>SCPServer</Company>
    <Product>SCP Secret Laboratory Stand Regen Plugin</Product>
    <Description>SCP 站立回血：站立不动 5 秒后开始回血，每秒 +10 血</Description>
    <Copyright>Copyright 2026</Copyright>
    <OutputType>Library</OutputType>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <LangVersion>12.0</LangVersion>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ExMod.Exiled" Version="9.13.3" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
