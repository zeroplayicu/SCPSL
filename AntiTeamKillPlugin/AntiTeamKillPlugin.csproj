<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>AntiTeamKillPlugin</AssemblyName>
    <RootNamespace>AntiTeamKillPlugin</RootNamespace>
    <Version>1.0.0</Version>
    <OutputType>Library</OutputType>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <LangVersion>12.0</LangVersion>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ExMod.Exiled" Version="9.13.3" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="HintServiceMeow-Exiled">
      <HintPath>..\Dependencies\HintServiceMeow-Exiled.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
