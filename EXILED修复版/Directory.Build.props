<Project>
  <!--
    BUG-36修复: 原实现硬编码绝对路径 Z:\aliyun备份\SCPSLSERVER\...，
    换机器/换人后直接构建失败。
    现改为：优先使用外部传入的 SCPSLManagedPath（环境变量或 -p: 参数），
    未传入时才回退到默认路径，便于不同机器各自配置。
    用法示例:
      dotnet build -p:SCPSLManagedPath="D:\SCPSL\SCPSL_Data\Managed"
      或设置环境变量 SCPSLManagedPath
  -->
  <PropertyGroup Condition="'$(SCPSLManagedPath)' == ''">
    <SCPSLManagedPath>Z:\aliyun备份\SCPSLSERVER\SCPSL_Data\Managed</SCPSLManagedPath>
  </PropertyGroup>
  
  <ItemGroup>
    <!-- Core game assemblies -->
    <Reference Include="Assembly-CSharp">
      <HintPath>$(SCPSLManagedPath)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>$(SCPSLManagedPath)\Assembly-CSharp-firstpass.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(SCPSLManagedPath)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(SCPSLManagedPath)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(SCPSLManagedPath)\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(SCPSLManagedPath)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Mirror">
      <HintPath>$(SCPSLManagedPath)\Mirror.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Mirror.Components">
      <HintPath>$(SCPSLManagedPath)\Mirror.Components.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="NorthwoodLib">
      <HintPath>$(SCPSLManagedPath)\NorthwoodLib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="CommandSystem.Core">
      <HintPath>$(SCPSLManagedPath)\CommandSystem.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="LabApi">
      <HintPath>$(SCPSLManagedPath)\LabApi.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Pooling">
      <HintPath>$(SCPSLManagedPath)\Pooling.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
