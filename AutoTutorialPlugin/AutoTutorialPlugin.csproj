<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>AutoTutorialPlugin</AssemblyName>
    <RootNamespace>AutoTutorialPlugin</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>Developer</Authors>
    <Company>SCPServer</Company>
    <Product>SCP Secret Laboratory Auto Tutorial Plugin</Product>
    <Description>玩家进入游戏自动变教程角色；准备倒计时少于3秒时变观察者</Description>
    <Copyright>Copyright 2026</Copyright>
    <OutputType>Library</OutputType>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <LangVersion>12.0</LangVersion>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ExMod.Exiled" Version="9.13.3" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
