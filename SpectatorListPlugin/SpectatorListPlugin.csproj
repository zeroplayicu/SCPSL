<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>SpectatorListPlugin</AssemblyName>
    <RootNamespace>SpectatorListPlugin</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>Developer</Authors>
    <Company>SCPServer</Company>
    <Product>SCP Secret Laboratory Spectator List Plugin</Product>
    <Description>Shows how many players are spectating, and optional detailed list of spectator names</Description>
    <Copyright>Copyright 2026</Copyright>
    <OutputType>Library</OutputType>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <LangVersion>12.0</LangVersion>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ExMod.Exiled" Version="9.13.3" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <Reference Include="HintServiceMeow-Exiled">
      <HintPath>..\Dependencies\HintServiceMeow-Exiled.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
